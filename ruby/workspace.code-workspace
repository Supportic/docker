// https://code.visualstudio.com/docs/editor/variables-reference
{
  "folders": [
    {
      "path": ".",
      "name": "App"
    }
  ],
  "settings": {
    "search.exclude": {
      "**/node_modules": true,
      "**/bower_components": true,
      "**/*.code-search": true,
      "**/var": true,
      "**/vendor": true,

      "composer.lock": true,
      "package-lock.json": true,
      "var/cache": true,
    },

    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true,
    },
  },
  "extensions": {
    "recommendations": [
      "ms-vscode-remote.remote-containers",
      "ms-azuretools.vscode-containers"
    ]
  }
}
